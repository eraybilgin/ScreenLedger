{
  "manifest_version": 3,
  "name": "Ekran Takip — Sekme Saatleri",
  "version": "1.0.0",
  "description": "Sekme geçişlerini yalnızca bu bilgisayardaki Ekran Takip uygulamasına gönderir.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8777/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "Ekran Takip — bağlantı durumu"},
  "options_page": "bilgi.html"
}
